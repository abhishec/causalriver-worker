# NexusBrain Production Dockerfile
# Multi-stage build for optimized image size
# ═══════════════════════════════════════════════════════════════

# ═════════════════════════════════════════════════════════════
# Stage 1: Dependencies
# ═════════════════════════════════════════════════════════════
FROM node:20-alpine AS deps

# Install pnpm
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/memory-stack/package.json ./packages/memory-stack/
COPY platform/package.json ./platform/

# Install dependencies
RUN pnpm install --frozen-lockfile --prod

# ═════════════════════════════════════════════════════════════
# Stage 2: Builder
# ═════════════════════════════════════════════════════════════
FROM node:20-alpine AS builder

RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

WORKDIR /app

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/memory-stack/node_modules ./packages/memory-stack/node_modules

# Copy source code
COPY . .

# Build packages
RUN pnpm build

# ═════════════════════════════════════════════════════════════
# Stage 3: Runner
# ═════════════════════════════════════════════════════════════
FROM node:20-alpine AS runner

# Install curl for health checks
RUN apk add --no-cache curl

# Create app user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nexusbrain

WORKDIR /app

# Copy built application
COPY --from=builder --chown=nexusbrain:nodejs /app/packages/memory-stack/dist ./packages/memory-stack/dist
COPY --from=builder --chown=nexusbrain:nodejs /app/scripts ./scripts
COPY --from=builder --chown=nexusbrain:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nexusbrain:nodejs /app/packages/memory-stack/node_modules ./packages/memory-stack/node_modules
COPY --from=builder --chown=nexusbrain:nodejs /app/package.json ./
COPY --from=builder --chown=nexusbrain:nodejs /app/packages/memory-stack/package.json ./packages/memory-stack/

# Install tsx for running TypeScript
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate && \
    pnpm add -g tsx

USER nexusbrain

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:3000/api/health || exit 1

# Start application
CMD ["tsx", "scripts/brain-orchestrator.ts"]
