{
  "name": "nexusbrain-cdk",
  "version": "1.0.0",
  "description": "NexusBrain AWS CDK Infrastructure",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "deploy": "cdk deploy --all --require-approval never",
    "deploy:prod": "cdk deploy NexusBrainProduction --require-approval never",
    "deploy:staging": "cdk deploy NexusBrainStaging --require-approval never",
    "destroy": "cdk destroy --all",
    "diff": "cdk diff",
    "synth": "cdk synth"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "aws-cdk": "^2.1108.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.241.0",
    "constructs": "^10.3.0",
    "source-map-support": "^0.5.21"
  }
}
