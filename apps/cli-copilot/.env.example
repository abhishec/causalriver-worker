# ═══════════════════════════════════════════════════════════════
# NexusBrain CLI Copilot — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Supabase (NexusBrain database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anthropic (Claude LLM)
ANTHROPIC_API_KEY=sk-ant-...

# Organization (your org in NexusBrain)
ORG_ID=your-org-uuid-here

# Optional: Override persona name (defaults to "NexusBrain Copilot")
# ORG_NAME=Developer Jarvis

# Optional: Claude model (defaults to claude-sonnet-4-5-20250929)
# MODEL=claude-sonnet-4-5-20250929

# Optional: Max tokens per response (defaults to 8192)
# MAX_TOKENS=8192
