# ────────────────────────────────────────────────────────────
# CausalRiver Worker — Environment Variables
# Copy to .env and fill in your values.
# ────────────────────────────────────────────────────────────

# ── OPTIONAL: Claude API (for future LLM-assisted explanation) ───
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── OPTIONAL: Agent card public URL ─────────────────────────────
CAUSAL_AGENT_CARD_URL=https://causal.agentbench.example.com

# ── OPTIONAL: Tuning ─────────────────────────────────────────────
FALLBACK_MODEL=claude-sonnet-4-6
TOOL_TIMEOUT=10
TASK_TIMEOUT=300
MAX_LAG=3
N_SHUFFLES=5
