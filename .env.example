# =============================================================================
# NexusBrain Environment Configuration
# Copy this to .env and fill in your values
# =============================================================================

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...

# LLM Providers (at least one required for copilot queries)
# These are also stored as Supabase Edge Function secrets for production use.
# Set via: supabase secrets set ANTHROPIC_API_KEY=sk-ant-... --project-ref <ref>
# Local values are used by the @nexus-ai/memory-stack library when consumed by any app.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Connector API Keys (optional — enable as needed)
HUBSPOT_API_KEY=pat-...
STRIPE_API_KEY=sk_live_...
INTERCOM_ACCESS_TOKEN=...

# Slack Connector (for Brain-native Slack sync + real-time webhooks)
# Required scopes: channels:history, channels:read, groups:history, groups:read,
#                  users:read, reactions:read, chat:write (for push capabilities)
SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=...  # Optional: for webhook signature verification

# Notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
ALERT_WEBHOOK_URL=https://your-app.com/api/nexus-alerts

# Edge Function Configuration (optional)
NEXUS_MAX_SIGNALS_PER_BATCH=500
NEXUS_CRON_SCHEDULE=0 2 * * *
