# =============================================================================
# NexusBrain Environment Configuration
# Copy this to .env and fill in your values
# =============================================================================

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...

# LLM Providers (at least one required for copilot queries)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Connector API Keys (optional — enable as needed)
HUBSPOT_API_KEY=pat-...
STRIPE_API_KEY=sk_live_...
INTERCOM_ACCESS_TOKEN=...

# Notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
ALERT_WEBHOOK_URL=https://your-app.com/api/nexus-alerts

# Edge Function Configuration (optional)
NEXUS_MAX_SIGNALS_PER_BATCH=500
NEXUS_CRON_SCHEDULE=0 2 * * *
