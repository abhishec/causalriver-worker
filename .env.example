# =============================================================================
# NexusBrain Environment Configuration
# Copy this to .env.local and fill in your values
# =============================================================================

# ── Supabase (required) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── App URLs (required for production, optional for local dev) ────────────────
# NEXT_PUBLIC_APP_URL=https://platform.usebrainos.com
# NEXT_PUBLIC_SITE_URL=https://platform.usebrainos.com

# ── LLM Providers ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...              # Optional — fallback LLM

# ── GitHub Connector (OAuth App) ──────────────────────────────────────────────
GITHUB_CLIENT_ID=Ov23li...
GITHUB_CLIENT_SECRET=...
# GITHUB_WEBHOOK_SECRET=whsec_...    # For GitHub webhook signature verification
# GITHUB_APP_ID=...                  # For GitHub App installation flow
# GITHUB_APP_PRIVATE_KEY=...         # Base64 PEM for GitHub App JWT

# ── Jira Connector (OAuth 2.0) ────────────────────────────────────────────────
# JIRA_CLIENT_ID=...
# JIRA_CLIENT_SECRET=...

# ── Slack Connector ───────────────────────────────────────────────────────────
# SLACK_CLIENT_ID=...
# SLACK_CLIENT_SECRET=...
# SLACK_SIGNING_SECRET=...
# SLACK_BOT_TOKEN=xoxb-...           # For Brain-native Slack sync

# ── Linear Connector ──────────────────────────────────────────────────────────
# LINEAR_WEBHOOK_SECRET=...
# LINEAR_SIGNING_SECRET=...

# ── Connector API Keys (optional — enable as needed) ──────────────────────────
# HUBSPOT_API_KEY=pat-...
# STRIPE_API_KEY=sk_live_...
# INTERCOM_ACCESS_TOKEN=...

# ── Internal API Security ─────────────────────────────────────────────────────
# SE_AAS_WORKER_SECRET=...           # Authenticates SE-aaS worker endpoint
# NEXUS_WEBHOOK_SECRET=...           # Validates outcome webhooks
# NEXUS_INTERNAL_API_KEY=...         # Protects observability/metrics endpoints

# ── AWS S3 Org Storage ───────────────────────────────────────────────────────
AWS_S3_BUCKET_NAME=nexusbrain-org-data
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# ── Notifications (optional) ──────────────────────────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# ALERT_WEBHOOK_URL=https://your-app.com/api/nexus-alerts

# ── Edge Function Configuration (optional) ────────────────────────────────────
# NEXUS_MAX_SIGNALS_PER_BATCH=500
# NEXUS_CRON_SCHEDULE=0 2 * * *
