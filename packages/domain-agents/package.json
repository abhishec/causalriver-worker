{
  "name": "@nexus-ai/domain-agents",
  "version": "0.1.0",
  "description": "Multi-domain AI agent framework. Hybrid intent classification, persona-aware prompting, capability-based access control, and graceful degradation.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./registry": {
      "import": "./dist/registry/index.js",
      "types": "./dist/registry/index.d.ts"
    },
    "./intent": {
      "import": "./dist/intent/index.js",
      "types": "./dist/intent/index.d.ts"
    },
    "./personas": {
      "import": "./dist/personas/index.js",
      "types": "./dist/personas/index.d.ts"
    },
    "./routing": {
      "import": "./dist/routing/index.js",
      "types": "./dist/routing/index.d.ts"
    },
    "./access": {
      "import": "./dist/access/index.js",
      "types": "./dist/access/index.d.ts"
    },
    "./hooks": {
      "import": "./dist/hooks/index.js",
      "types": "./dist/hooks/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nexus-ai/memory-stack": "workspace:*"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "@supabase/supabase-js": "^2.0.0",
    "@types/react": "^18.0.0"
  },
  "keywords": [
    "ai-agents",
    "intent-classification",
    "domain-routing",
    "personas",
    "multi-agent",
    "graceful-degradation",
    "module-access",
    "typescript",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/abhishec/nexus-intelligence",
    "directory": "packages/domain-agents"
  },
  "homepage": "https://github.com/abhishec/nexus-intelligence#readme",
  "bugs": {
    "url": "https://github.com/abhishec/nexus-intelligence/issues"
  }
}
