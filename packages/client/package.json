{
  "name": "@nexus-ai/client",
  "version": "0.1.0",
  "description": "Lightweight HTTP client for NexusBrain \u2014 query, ingest signals, and receive causal intelligence from any app or agent.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "nexusbrain",
    "causal-intelligence",
    "ai-memory",
    "sdk",
    "client",
    "agent-integration"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/abhishec/nexus-intelligence",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/abhishec/nexus-intelligence#readme"
}
