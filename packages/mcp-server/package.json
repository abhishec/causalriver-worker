{
  "name": "@nexus-ai/mcp-server",
  "version": "0.1.0",
  "description": "MCP server for NexusBrain \u2014 gives Claude Desktop and Claude Code access to causal intelligence via the Model Context Protocol.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "nexus-mcp-server": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && chmod +x dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@nexus-ai/client": "workspace:*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "nexusbrain",
    "mcp",
    "model-context-protocol",
    "claude-desktop",
    "claude-code",
    "causal-intelligence",
    "ai-tools"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/abhishec/nexus-intelligence",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/abhishec/nexus-intelligence#readme"
}
