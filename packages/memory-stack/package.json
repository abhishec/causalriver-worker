{
  "name": "@nexus-ai/memory-stack",
  "version": "0.1.0",
  "description": "7-layer causal intelligence engine for TypeScript. Granger causality, PC algorithm, do-calculus, pattern learning, and embeddings — no Python, no GPU.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./causality": {
      "types": "./dist/causality/index.d.ts",
      "import": "./dist/causality/index.js",
      "default": "./dist/causality/index.js"
    },
    "./learning": {
      "types": "./dist/learning/index.d.ts",
      "import": "./dist/learning/index.js",
      "default": "./dist/learning/index.js"
    },
    "./embeddings": {
      "types": "./dist/core/embeddings/index.d.ts",
      "import": "./dist/core/embeddings/index.js",
      "default": "./dist/core/embeddings/index.js"
    },
    "./intelligence": {
      "types": "./dist/intelligence/index.d.ts",
      "import": "./dist/intelligence/index.js",
      "default": "./dist/intelligence/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "default": "./dist/hooks/index.js"
    },
    "./persistence": {
      "types": "./dist/persistence/index.d.ts",
      "import": "./dist/persistence/index.js",
      "default": "./dist/persistence/index.js"
    },
    "./code-indexing": {
      "types": "./dist/code-indexing/index.d.ts",
      "import": "./dist/code-indexing/index.js",
      "default": "./dist/code-indexing/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:benchmark": "vitest run --reporter=verbose src/__tests__/benchmark-runner.test.ts",
    "test:brain-health": "vitest run --reporter=verbose src/__tests__/brain-health.test.ts",
    "query:jarvis": "tsx src/demo/jarvis-query.ts",
    "jarvis": "tsx src/demo/developer-jarvis.ts",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@octokit/rest": "^20.1.2",
    "@slack/web-api": "^7.0.0",
    "@typescript-eslint/parser": "^6.21.0",
    "dotenv": "^16.0.0",
    "exponential-backoff": "^3.1.3",
    "ioredis": "^5.9.3",
    "jira.js": "^5.3.0",
    "p-queue": "^9.1.0",
    "p-retry": "^7.1.1",
    "simple-git": "^3.22.0",
    "tree-sitter": "^0.21.0",
    "tree-sitter-go": "^0.21.0",
    "tree-sitter-java": "^0.21.0",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-scala": "^0.24.0"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "@types/react": "^18.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "causal-inference",
    "granger-causality",
    "do-calculus",
    "pc-algorithm",
    "causal-discovery",
    "pattern-detection",
    "anomaly-detection",
    "embeddings",
    "organizational-intelligence",
    "machine-learning",
    "typescript",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/abhishec/nexus-intelligence",
    "directory": "packages/memory-stack"
  },
  "homepage": "https://github.com/abhishec/nexus-intelligence#readme",
  "bugs": {
    "url": "https://github.com/abhishec/nexus-intelligence/issues"
  }
}
