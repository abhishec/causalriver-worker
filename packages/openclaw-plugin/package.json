{
  "name": "@nexusbrain/openclaw-plugin",
  "version": "0.1.0",
  "description": "OpenClaw plugin for NexusBrain — closes the causal reinforcement loop with always-on outcome collection, feedback verification, and proactive intelligence.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "openclaw": {
    "extensions": ["./dist/index.js"]
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "skills",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nexus-ai/client": "workspace:*",
    "@nexus-ai/mcp-server": "workspace:*",
    "@nexus-ai/memory-stack": "workspace:*",
    "@sinclair/typebox": "^0.32.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "openclaw",
    "nexusbrain",
    "causal-intelligence",
    "reinforcement-learning",
    "autonomous-agent",
    "se-aas",
    "aas"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/abhishec/nexus-intelligence",
    "directory": "packages/openclaw-plugin"
  },
  "homepage": "https://github.com/abhishec/nexus-intelligence#openclaw-plugin"
}
