# Brain OS Platform — Environment Variables
# ==========================================
#
# Copy this file to .env.local and fill in your credentials:
#   cp .env.example .env.local
#
# Required variables must be set for the app to start.
# Optional variables enable additional features.

# ── Required: Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Required: Anthropic (Claude AI) ─────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key

# ── Optional: AWS S3 (document uploads) ─────────────────────────────
# If not set, uploads fall back to Supabase Storage.
# AWS_S3_BUCKET_NAME=your-bucket
# AWS_S3_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# ── Optional: GitHub App (PR reviews, webhooks) ─────────────────────
# GITHUB_APP_ID=your-app-id
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_WEBHOOK_SECRET=your-webhook-secret

# ── Optional: App URL (used for server-to-server calls) ───────────
# In dev, defaults to http://localhost:3001. In production, set to your domain.
# NEXT_PUBLIC_APP_URL=http://localhost:3001

# ── Required in Production: Cron Authentication ──────────────────────
# Used by Vercel Cron to authenticate scheduled job requests.
# Set via Vercel dashboard or environment. All cron routes require this.
# CRON_SECRET=your-cron-secret

# ── Optional: Dev tuning ────────────────────────────────────────────
# LOG_LEVEL=debug             # debug | info | warn | error (default: warn in dev, info in prod)
# DEV_ENABLE_IDS=true         # Enable IDS security middleware in dev (default: disabled for speed)
