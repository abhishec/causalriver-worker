{
  "name": "nexus-intelligence",
  "private": true,
  "description": "Open-source causal intelligence and domain agent framework for TypeScript",
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "security:scan": "tsx scripts/run-security-agent.ts",
    "security:scan:dry": "tsx scripts/run-security-agent.ts --dry-run",
    "security:scan:verbose": "tsx scripts/run-security-agent.ts --verbose",
    "security:daily": "bash scripts/daily-security-scan.sh",
    "security:setup:cron": "bash scripts/setup-daily-cron.sh",
    "security:deps:check": "tsx scripts/audit-all-packages.ts",
    "security:deps:fix": "cd packages/memory-stack && npm audit fix && cd ../.. && cd platform && npm audit fix && cd ..",
    "job:run": "tsx scripts/run-scheduled-job.ts",
    "job:verification": "tsx scripts/run-scheduled-job.ts verification",
    "job:weights": "tsx scripts/run-scheduled-job.ts weights",
    "job:decay": "tsx scripts/run-scheduled-job.ts decay",
    "job:threshold": "tsx scripts/run-scheduled-job.ts threshold",
    "job:retention": "tsx scripts/run-scheduled-job.ts retention",
    "job:federation": "tsx scripts/run-scheduled-job.ts federation",
    "job:consolidation": "tsx scripts/run-scheduled-job.ts consolidation",
    "job:all-daily": "tsx scripts/run-scheduled-job.ts all_daily",
    "verify:wiring": "tsx scripts/verify-brain-wiring.ts"
  },
  "devDependencies": {
    "tsx": "^4.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "pnpm@9.0.0"
}
