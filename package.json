{
  "name": "nexus-intelligence",
  "private": true,
  "description": "Open-source causal intelligence and domain agent framework for TypeScript",
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "security:scan": "tsx scripts/run-security-agent.ts",
    "security:scan:dry": "tsx scripts/run-security-agent.ts --dry-run",
    "security:scan:verbose": "tsx scripts/run-security-agent.ts --verbose",
    "security:daily": "bash scripts/daily-security-scan.sh",
    "security:setup:cron": "bash scripts/setup-daily-cron.sh",
    "security:deps:check": "tsx scripts/audit-all-packages.ts",
    "security:deps:fix": "cd packages/memory-stack && npm audit fix && cd ../.. && cd platform && npm audit fix && cd ..",
    "job:run": "tsx scripts/run-scheduled-job.ts",
    "job:verification": "tsx scripts/run-scheduled-job.ts verification",
    "job:weights": "tsx scripts/run-scheduled-job.ts weights",
    "job:decay": "tsx scripts/run-scheduled-job.ts decay",
    "job:threshold": "tsx scripts/run-scheduled-job.ts threshold",
    "job:retention": "tsx scripts/run-scheduled-job.ts retention",
    "job:federation": "tsx scripts/run-scheduled-job.ts federation",
    "job:oracle": "tsx scripts/run-scheduled-job.ts oracle",
    "job:consolidation": "tsx scripts/run-scheduled-job.ts consolidation",
    "job:full-consolidation": "tsx scripts/run-full-consolidation.ts",
    "job:full-consolidation:via-runner": "tsx scripts/run-scheduled-job.ts full_consolidation",
    "job:all-daily": "tsx scripts/run-scheduled-job.ts all_daily",
    "verify:wiring": "tsx scripts/verify-brain-wiring.ts",
    "verify:db": "tsx scripts/validate-database-schema.ts",
    "verify:all": "tsx scripts/comprehensive-validation.ts",
    "test:jobs": "tsx scripts/test-manual-job.ts",
    "test:rl-deepcheck": "tsx scripts/e2e-rl-brain-deepcheck.ts",
    "test:rl-deepcheck:verbose": "tsx scripts/e2e-rl-brain-deepcheck.ts --verbose",
    "test:rl-deepcheck:dry": "tsx scripts/e2e-rl-brain-deepcheck.ts --dry-run --verbose",
    "test:rl-deepcheck:5rounds": "tsx scripts/e2e-rl-brain-deepcheck.ts --rounds=5 --verbose --keep-data",
    "check:jobs": "tsx scripts/check-job-execution.ts",
    "check:production": "tsx scripts/production-deployment-check.ts",
    "ingest:initial": "tsx scripts/run-batch-ingestion.ts --mode initial --sources slack,jira,github --verbose",
    "ingest:slack": "tsx scripts/run-batch-ingestion.ts --mode initial --sources slack --verbose",
    "ingest:jira": "tsx scripts/run-batch-ingestion.ts --mode initial --sources jira --verbose",
    "ingest:github": "tsx scripts/run-batch-ingestion.ts --mode initial --sources github --verbose",
    "ingest:incremental": "tsx scripts/run-batch-ingestion.ts --mode incremental --sources slack,jira,github --verbose",
    "ingest:resume": "tsx scripts/run-batch-ingestion.ts --resume",
    "monitor": "tsx scripts/monitor-and-heal.ts",
    "monitor:once": "tsx scripts/monitor-and-heal.ts --once",
    "monitor:verbose": "tsx scripts/monitor-and-heal.ts --verbose",
    "reload:schema": "tsx scripts/reload-supabase-schema.ts",
    "verify:schema": "tsx scripts/verify-supabase-schema.ts",
    "verify:functions": "tsx scripts/test-all-edge-functions.ts",
    "verify:complete": "tsx scripts/verify-supabase-schema.ts && tsx scripts/test-all-edge-functions.ts",
    "test:load": "tsx scripts/load-test-10m.ts",
    "test:load:light": "tsx scripts/load-test-10m.ts --mode light",
    "test:load:medium": "tsx scripts/load-test-10m.ts --mode medium",
    "demo:memory-genesis": "tsx competition/memory-genesis/demo-script.ts",
    "demo:memory-genesis:quick": "DEMO_DAYS=30 tsx competition/memory-genesis/demo-script.ts",
    "demo:memory-genesis:verbose": "VERBOSE=true tsx competition/memory-genesis/demo-script.ts",
    "demo:memory-genesis:test": "tsx competition/memory-genesis/test-supabase.ts",
    "demo:memory-genesis:realistic": "tsx competition/memory-genesis/demo-realistic.ts",
    "demo:memory-genesis:realistic:quick": "DEMO_DAYS=30 tsx competition/memory-genesis/demo-realistic.ts",
    "demo:memory-genesis:realistic:verbose": "DEMO_DAYS=90 VERBOSE=true tsx competition/memory-genesis/demo-realistic.ts",
    "demo:setup": "tsx scripts/setup-demo-org.ts",
    "demo:setup:quick": "DATA_DAYS=90 tsx scripts/setup-demo-org.ts",
    "demo:setup:full": "DATA_DAYS=180 tsx scripts/setup-demo-org.ts",
    "test:load:full": "tsx scripts/load-test-10m.ts --mode full",
    "sim:design-partner": "tsx scripts/simulate-design-partner.ts",
    "ci:heal": "tsx scripts/run-ci-healer.ts",
    "ci:heal:diagnose": "tsx scripts/run-ci-healer.ts --mode diagnose",
    "ci:heal:retry": "tsx scripts/run-ci-healer.ts --mode retry",
    "ci:heal:dry": "tsx scripts/run-ci-healer.ts --dry-run"
  },
  "devDependencies": {
    "@types/cron": "^2.4.3",
    "cron": "^4.4.0",
    "dotenv": "^16.0.0",
    "tsx": "^4.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "axios": ">=1.13.5",
      "esbuild": ">=0.25.0",
      "qs": ">=6.14.2",
      "lodash-es": ">=4.17.23"
    }
  }
}
