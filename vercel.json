{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @nexus-ai/memory-stack build && cd platform && pnpm build",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "outputDirectory": "platform/.next",
  "crons": [
    {
      "path": "/api/brain/health/cron",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/cognitive-cycle",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/process-jobs",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/learning",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron/evolution",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/autonomous-monitor",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/rlvr",
      "schedule": "0 3 * * *"
    }
  ]
}
