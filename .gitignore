# ════════════════════════════════════════════════════════════════════
# Security-Critical Exclusions (Added by Security Hardening Agent)
# ════════════════════════════════════════════════════════════════════

# Private Keys & Certificates
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# Credentials & Secrets
credentials.json
*-credentials.json
secrets.yaml
secrets.yml
.aws/
.gcp/
*_rsa
*_dsa
*_ed25519
*_ecdsa

# Security Scan Reports
gitleaks-report.*
security-report.*
security-deps-audit.json
vulnerability-scan.*
*.sarif

# Logs (may contain sensitive data)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# Temporary files
*.tmp
*.temp
.temp/
*.swp
*.swo

# CDK output directories (may contain hardcoded secrets/synthesized configs)
infrastructure/cdk/cdk.out/
infrastructure/cdk/cdk.out.*/
infrastructure/cdk/cdk.out*.json

# Archive SQL files (may contain hardcoded keys)
docs/archive/

# Backup files
*.bak

# Playwright
platform/.auth/
test-results/
playwright-report/

# IDE configs (may contain paths/secrets)
.idea/
.vscode/settings.json
*.sublime-workspace

# Claude agent worktrees — NEVER commit these.
# These are ephemeral git worktrees created by Claude Code agent sessions.
# Committing them breaks GitHub Actions (fatal: No url found for submodule path).
.claude/worktrees/
