<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- NexusBrain Consolidation Engine ("Brain Sleep") -->
    <!-- Runs nightly at 2 AM — deep consolidation of all org brains -->
    <key>Label</key>
    <string>com.nexusbrain.consolidation</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/abhishek/bin/nexusbrain-runner.sh</string>
        <string>consolidation</string>
    </array>

    <!-- Run at 2:00 AM every day -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Logging handled by nexusbrain-runner.sh (appends to ~/Library/Logs/) -->
    <!-- No StandardOutPath/StandardErrorPath — launchd truncates on each run -->

    <!-- Don't restart on crash — wait for next scheduled run -->
    <key>KeepAlive</key>
    <false/>

    <!-- Environment -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/abhishek</string>
    </dict>
</dict>
</plist>
