<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- NexusBrain Consolidation Engine ("Brain Sleep") -->
    <!-- Runs nightly at 2 AM — deep consolidation of all org brains -->
    <key>Label</key>
    <string>com.nexusbrain.consolidation</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/abhishek/Library/CloudStorage/GoogleDrive-abhishek@monetiz3.com/My Drive/Workspace - Monetize Organisation/02 - Product/NexusBrain/scripts/run-brain-agents.sh</string>
        <string>consolidation</string>
    </array>

    <!-- Run at 2:00 AM every day -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Log output -->
    <key>StandardOutPath</key>
    <string>/Users/abhishek/Library/Logs/nexusbrain-consolidation.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/abhishek/Library/Logs/nexusbrain-consolidation-error.log</string>

    <!-- Keep alive only on schedule (don't restart on crash) -->
    <key>KeepAlive</key>
    <false/>

    <!-- Environment -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
