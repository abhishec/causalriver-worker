<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- NexusBrain DMN Engine ("Default Mode Network") -->
    <!-- Runs every 4 hours — background insight scanning -->
    <key>Label</key>
    <string>com.nexusbrain.dmn</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/abhishek/bin/nexusbrain-runner.sh</string>
        <string>dmn</string>
    </array>

    <!-- Run every 4 hours (14400 seconds) -->
    <key>StartInterval</key>
    <integer>14400</integer>

    <!-- Logging handled by nexusbrain-runner.sh (appends to ~/Library/Logs/) -->
    <!-- No StandardOutPath/StandardErrorPath — launchd truncates on each run -->

    <!-- Don't restart on crash — wait for next interval -->
    <key>KeepAlive</key>
    <false/>

    <!-- Environment -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/abhishek</string>
    </dict>
</dict>
</plist>
